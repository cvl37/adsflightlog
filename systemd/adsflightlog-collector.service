[Unit]
Description=ADS Flight Log collector (logs aircraft inside the configured radius)
# Ordering only: don't pull in a native readsb. The decoder may run elsewhere
# (e.g. a Docker ultrafeeder), and the collector retries until aircraft.json exists.
After=readsb.service docker.service

[Service]
User=@USER@
WorkingDirectory=@DIR@
ExecStart=/usr/bin/python3 -m adsflightlog.collector @DIR@/config.toml
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
