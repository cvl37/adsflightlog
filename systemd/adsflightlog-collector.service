[Unit]
Description=ADS Flight Log collector (logs aircraft inside the configured radius)
After=readsb.service
Wants=readsb.service

[Service]
User=@USER@
WorkingDirectory=@DIR@
ExecStart=/usr/bin/python3 -m adsflightlog.collector @DIR@/config.toml
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
